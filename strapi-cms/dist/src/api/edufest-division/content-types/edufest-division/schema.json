{
    "kind": "collectionType",
    "collectionName": "edufest_divisions",
    "info": {
        "singularName": "edufest-division",
        "pluralName": "edufest-divisions",
        "displayName": "Edufest Divisi",
        "description": "Divisi dan Kepanitiaan Edufest"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "name": {
            "type": "string",
            "required": true
        },
        "slug": {
            "type": "uid",
            "targetField": "name",
            "required": true
        },
        "type": {
            "type": "enumeration",
            "enum": [
                "core",
                "division"
            ],
            "default": "division",
            "required": true
        },
        "coordinator_name": {
            "type": "string"
        },
        "order": {
            "type": "integer",
            "default": 0
        },
        "members": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::edufest-member.edufest-member",
            "mappedBy": "division"
        }
    }
}
