{
    "kind": "collectionType",
    "collectionName": "halamans",
    "info": {
        "singularName": "halaman",
        "pluralName": "halamans",
        "displayName": "Halaman Utama",
        "description": "Pengaturan konten dan metadata untuk 5 halaman utama website"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "nama_halaman": {
            "type": "string",
            "required": true
        },
        "slug": {
            "type": "uid",
            "targetField": "nama_halaman",
            "required": true
        },
        "judul_hero": {
            "type": "string"
        },
        "sub_judul": {
            "type": "text"
        },
        "deskripsi": {
            "type": "richtext"
        },
        "banner_image": {
            "type": "media",
            "multiple": false,
            "allowedTypes": [
                "images",
                "files",
                "videos",
                "audios"
            ]
        },
        "gambar_list": {
            "type": "media",
            "multiple": true,
            "allowedTypes": [
                "images",
                "files"
            ]
        },
        "seo_title": {
            "type": "string"
        },
        "seo_description": {
            "type": "text"
        },
        "is_active": {
            "type": "boolean",
            "default": true
        },
        "metadata_json": {
            "type": "json"
        },
        "enable_compression": {
            "type": "boolean",
            "default": true
        },
        "compression_quality": {
            "type": "integer",
            "min": 0,
            "max": 100,
            "default": 75
        },
        "mode_ukuran_frame": {
            "type": "enumeration",
            "enum": [
                "auto",
                "contain",
                "cover",
                "square"
            ],
            "default": "auto"
        },
        "layout_grid_dokumentasi": {
            "type": "enumeration",
            "enum": [
                "grid_3_col",
                "grid_2_col",
                "grid_4_col",
                "grid_1_col",
                "masonry"
            ],
            "default": "grid_3_col"
        },
        "background_image": {
            "type": "media",
            "multiple": false,
            "allowedTypes": [
                "images"
            ]
        },
        "logo": {
            "type": "media",
            "multiple": false,
            "allowedTypes": [
                "images"
            ]
        },
        "overlay_text": {
            "type": "text",
            "pluginOptions": {},
            "default": "Bergerak\nBersama,\nMenciptakan Jejak\nPositif"
        },
        "bg_color": {
            "type": "string",
            "default": "#185FA5"
        },
        "dot_color": {
            "type": "string",
            "default": "rgba(0, 0, 0, 0.25)"
        },
        "dot_size": {
            "type": "string",
            "default": "2.5px"
        },
        "dot_gap": {
            "type": "string",
            "default": "24px 24px"
        },
        "overlay_image": {
            "type": "media",
            "multiple": false,
            "allowedTypes": [
                "images"
            ]
        },
        "embed_youtube": {
            "type": "string"
        },
        "embed_spotify": {
            "type": "string"
        },
        "embed_tiktok": {
            "type": "string"
        },
        "embed_instagram": {
            "type": "string"
        },
        "link_instagram": {
            "type": "string"
        },
        "link_tiktok": {
            "type": "string"
        },
        "link_youtube": {
            "type": "string"
        },
        "link_spotify": {
            "type": "string"
        }
    }
}
