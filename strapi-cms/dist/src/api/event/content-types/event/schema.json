{
    "kind": "collectionType",
    "collectionName": "events",
    "info": {
        "singularName": "event",
        "pluralName": "events",
        "displayName": "Event",
        "description": ""
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "nama": {
            "type": "string",
            "required": true
        },
        "slug": {
            "type": "uid",
            "targetField": "nama",
            "required": true
        },
        "tanggal": {
            "type": "datetime"
        },
        "lokasi": {
            "type": "string"
        },
        "deskripsi": {
            "type": "richtext"
        },
        "banner": {
            "type": "media",
            "multiple": false,
            "allowedTypes": [
                "images",
                "files",
                "videos",
                "audios"
            ]
        },
        "highlights": {
            "type": "media",
            "multiple": true,
            "allowedTypes": [
                "images",
                "files",
                "videos",
                "audios"
            ]
        },
        "kategori": {
            "type": "enumeration",
            "enum": [
                "internal",
                "eksternal"
            ]
        },
        "status": {
            "type": "enumeration",
            "enum": [
                "draft",
                "published",
                "archived"
            ],
            "default": "draft"
        },
        "tema": {
            "type": "string"
        },
        "tagline": {
            "type": "string"
        },
        "ringkasan": {
            "type": "text"
        },
        "sub_judul": {
            "type": "string"
        },
        "tanggal_mulai": {
            "type": "datetime"
        },
        "tanggal_selesai": {
            "type": "datetime"
        },
        "cta_url": {
            "type": "string"
        },
        "youtube_url": {
            "type": "string"
        },
        "artikel_madings": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::artikel-mading.artikel-mading",
            "mappedBy": "event"
        }
    }
}
