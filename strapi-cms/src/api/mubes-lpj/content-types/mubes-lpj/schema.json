{
  "kind": "collectionType",
  "collectionName": "mubes_lpjs",
  "info": {
    "singularName": "mubes-lpj",
    "pluralName": "mubes-lpjs",
    "displayName": "🏛️ [MUBES] LPJ & Anggaran Proker",
    "description": "LPJ body via repeatable sections (Tujuan, Teknis, Capaian, Evaluasi, …). Legacy fields kept optional for existing entries."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "program_kerja": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::program-kerja.program-kerja"
    },
    "sections": {
      "type": "component",
      "repeatable": true,
      "component": "program-kerja.lpj-section"
    },
    "realisasi_anggaran": {
      "type": "decimal",
      "precision": 14,
      "scale": 2,
      "required": false
    },
    "sumber_dana": {
      "type": "string",
      "required": false
    },
    "evaluasi_internal": {
      "type": "richtext",
      "required": false
    },
    "pendahuluan": {
      "type": "richtext",
      "required": false
    },
    "golongan_target": {
      "type": "string",
      "required": false
    },
    "teknis_pelaksanaan": {
      "type": "richtext",
      "required": false
    },
    "kendala_solusi": {
      "type": "json"
    },
    "nota_kwitansi": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "status_pengesahan": {
      "type": "enumeration",
      "enum": [
        "draft",
        "ditinjau",
        "disahkan"
      ],
      "default": "draft",
      "required": true
    }
  }
}
