{
  "kind": "collectionType",
  "collectionName": "artikel_madings",
  "info": {
    "singularName": "artikel-mading",
    "pluralName": "artikel-madings",
    "displayName": "🌐 [VISITOR] Artikel Mading",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "judul": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "judul",
      "required": true
    },
    "kategori": {
      "type": "enumeration",
      "enum": [
        "berita",
        "karya_sastra",
        "edukasi"
      ],
      "required": true
    },
    "konten": {
      "type": "richtext",
      "required": true
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "tanggal_terbit": {
      "type": "datetime"
    },
    "tags": {
      "type": "json"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "penulis": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::anggota-osis.anggota-osis"
    },
    "event": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event.event",
      "inversedBy": "artikel_madings"
    }
  }
}
