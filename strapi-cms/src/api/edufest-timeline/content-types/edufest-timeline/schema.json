{
  "kind": "collectionType",
  "collectionName": "edufest_timelines",
  "info": {
    "singularName": "edufest-timeline",
    "pluralName": "edufest-timelines",
    "displayName": "🌐 [VISITOR] Edufest Timeline",
    "description": "Riwayat Sejarah Edufest Per Tahun"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
