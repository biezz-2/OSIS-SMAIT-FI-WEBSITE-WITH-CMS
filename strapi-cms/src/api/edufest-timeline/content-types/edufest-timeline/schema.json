    "year": {
      "type": "string",
      "required": true
    },
    "date_label": {
      "type": "string"
    },
    "theme": {
      "type": "string"
    },
    "participants": {
      "type": "string"
    },
    "guests": {
      "type": "component",
      "repeatable": true,
      "component": "edufest.guest"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
