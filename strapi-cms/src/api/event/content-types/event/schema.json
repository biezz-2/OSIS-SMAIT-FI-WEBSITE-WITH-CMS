{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event",
    "description": "Pengaturan event, agenda kegiatan, dan landing page event OSIS SMAIT Fithrah Insani"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nama": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nama",
      "required": true
    },
    "tagline": {
      "type": "string"
    },
    "sub_judul": {
      "type": "string"
    },
    "tema": {
      "type": "string"
    },
    "kategori": {
      "type": "enumeration",
      "enum": [
        "internal",
        "eksternal"
      ]
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "tanggal_mulai": {
      "type": "datetime"
    },
    "tanggal_selesai": {
      "type": "datetime"
    },
    "tanggal": {
      "type": "datetime"
    },
    "lokasi": {
      "type": "string"
    },
    "ringkasan": {
      "type": "text"
    },
    "deskripsi": {
      "type": "richtext"
    },
    "banner": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "highlights": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "cta_url": {
      "type": "string"
    },
    "galeri_teks_utama": {
      "type": "text"
    },
    "galeri_deskripsi": {
      "type": "text"
    },
    "youtube_url": {
      "type": "string"
    },
    "artikel_madings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::artikel-mading.artikel-mading",
      "mappedBy": "event"
    }
  }
}