{
  "kind": "collectionType",
  "collectionName": "media_assets",
  "info": {
    "singularName": "media-asset",
    "pluralName": "media-assets",
    "displayName": "Media Asset",
    "description": "Pengelolaan foto, video, audio, dan link media eksternal website"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "key": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "judul": {
      "type": "string",
      "required": true
    },
    "kategori": {
      "type": "enumeration",
      "enum": [
        "hero",
        "about",
        "audio",
        "ticker",
        "timeline",
        "edufest",
        "sosmed",
        "general"
      ],
      "default": "general"
    },
    "tipe_media": {
      "type": "enumeration",
      "enum": [
        "foto",
        "video",
        "audio"
      ],
      "default": "foto"
    },
    "file": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "url_external": {
      "type": "string"
    },
    "deskripsi": {
      "type": "text"
    },
    "urutan": {
      "type": "integer"
    }
  }
}
